# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# SQLite by default — no database server needed for local development.
DATABASE_URL="file:./prisma/luma.db"

# Base URL of this instance. Must match the redirect URI registered with Google.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI extraction (required)
# ---------------------------------------------------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional overrides. The model is deliberately configurable so it can be
# changed without a code change.
# LUMA_MODEL="claude-opus-5"
# LUMA_EFFORT="high"   # low | medium | high | xhigh | max

# ---------------------------------------------------------------------------
# Gmail (optional — the sample inbox works without it)
# ---------------------------------------------------------------------------
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URI:
#   http://localhost:3000/api/auth/google/callback
#
# Luma requests read-only Gmail scope. It cannot send, delete, or modify mail.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Secrets (required in production; dev fallbacks exist for local work)
# ---------------------------------------------------------------------------
# Signs the session cookie.        Generate: openssl rand -base64 32
SESSION_SECRET=""
# Encrypts provider tokens at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=""

# debug | info | warn | error
LOG_LEVEL="info"

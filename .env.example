# ---------------------------------------------------------------------------
# Copy to .env and fill in.  cp .env.example .env
#
# .env is gitignored. Never commit real values.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# SQLite by default — no database server needed for local development.
DATABASE_URL="file:./prisma/luma.db"

# Base URL of this instance. Must match the redirect URI registered with Google.
APP_URL="http://localhost:3000"

# debug | info | warn | error
LOG_LEVEL="info"

# --- Secrets ---------------------------------------------------------------
# REQUIRED IN PRODUCTION (min 32 chars). Development falls back to fixed
# dev-only values so `npm run dev` works with no setup; production refuses to
# start without real ones.
#
#   openssl rand -base64 32
#
SESSION_SECRET=""     # signs the session cookie
ENCRYPTION_KEY=""     # encrypts stored provider tokens

# --- AI extraction (optional) ----------------------------------------------
# Without this, ingestion and the API still work; extraction is reported as
# unavailable rather than crashing. https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# LUMA_MODEL="claude-opus-5"
# LUMA_EFFORT="high"          # low | medium | high | xhigh | max

# --- Gmail (optional) ------------------------------------------------------
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URI:
#   http://localhost:3000/api/auth/google/callback
#
# Luma requests read-only Gmail scope. It cannot send, delete, or modify mail.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Development affordances ------------------------------------------------
# The sample-inbox route signs in a demo user without OAuth. On by default
# outside production; set to "true" to allow it in production too.
# ENABLE_DEMO_MODE="true"
